# Copie este arquivo para .env.local e preencha com os dados do seu projeto.
#   cp .env.example .env.local
# Nunca versione o .env.local nem coloque chaves direto no código.

# Supabase → Project Settings → Data API → Project URL
# Só o endereço base, terminando em .supabase.co (sem /rest/v1 no final).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...).
# Em projetos antigos, a "anon key" também funciona aqui.
# É pública por natureza: a segurança dos dados vem do RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUA_CHAVE

# Endereço do app, usado no link de confirmação de e-mail.
# Em produção, use o domínio real (ex.: https://app.aprovaposts.com.br).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API Keys → Secret key (sb_secret_...).
# Em projetos antigos, a "service_role key" também funciona aqui.
# SECRETA: ignora o RLS. Só o servidor usa (página do link mágico /a/[token]).
# Nunca coloque o prefixo NEXT_PUBLIC_ nem a exponha no navegador.
SUPABASE_SECRET_KEY=sb_secret_SUA_CHAVE

# --- Opcional: avisos por e-mail quando o cliente responde -------------------
# Sem RESEND_API_KEY, os avisos aparecem só em "Novidades" no painel.
# Crie a chave em https://resend.com → API Keys. Também é SECRETA (sem NEXT_PUBLIC_).
RESEND_API_KEY=
# Quem envia o e-mail. O padrão (onboarding@resend.dev) só entrega para o
# e-mail dono da conta no Resend; para outros, verifique um domínio no Resend.
EMAIL_REMETENTE=Aprova Posts <onboarding@resend.dev>
